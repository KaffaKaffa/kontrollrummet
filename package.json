{
  "name": "control-room",
  "private": true,
  "version": "0.1.0",
  "description": "Kontrollrummet: agentteam per repo, en agent per app, och en board där varje uppgift går att följa.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "vite build --config web/vite.config.ts && node --disable-warning=ExperimentalWarning server/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p . --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "install:mac": "scripts/install-mac.sh",
    "uninstall:mac": "scripts/uninstall-mac.sh",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "cross-spawn": "7.0.6",
    "postprocessing": "6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "@types/cross-spawn": "6.0.6"
  }
}
